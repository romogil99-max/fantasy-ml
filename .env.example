# Copia este archivo a .env y llena los valores. .env NUNCA se sube a git.
# ID de la liga: aparece en la URL de ESPN (...?leagueId=XXXXXX)
ESPN_LEAGUE_ID=
# Cookies de espn.com (DevTools > Application > Cookies): espn_s2 y SWID
ESPN_S2=
# SWID incluye las llaves, p. ej. {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_SWID=
# ID de tu equipo dentro de la liga: aparece en la URL de tu equipo (...&teamId=N)
ESPN_TEAM_ID=
